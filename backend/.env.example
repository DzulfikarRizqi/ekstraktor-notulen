# === Database (SQLite) ===
DATABASE_URL=sqlite:///./dev.db

# === Google Generative AI (tahap ekstraksi) ===
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# === LM Studio (OpenAI-compatible) — tahap prefilter & verifikasi ===
LM_STUDIO_BASE_URL=http://localhost:1234/v1
LM_STUDIO_MODEL=qwen2.5-3b-instruct

# === Threshold verifikasi ===
CONF_THRESHOLD=0.6
EMBED_VERIFY_THRESHOLD=0.5
USE_EMBEDDING_FALLBACK=true

# === Embedding (sentence-transformers, ganti Transformers.js ONNX) ===
EMBEDDING_MODEL=intfloat/multilingual-e5-small