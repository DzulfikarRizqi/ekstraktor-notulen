# === Database ===
DATABASE_URL="file:./dev.db"

# === Google Generative AI (khusus tahap ekstraksi saat provider gemini) ===
# Free tier dibatasi 5 request/menit; pipeline hybrid menjaga konsumsi 1 call/dokumen.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# === LM Studio (OpenAI-compatible) — prefilter & verifikasi selalu lokal ===
# Juga dipakai untuk ekstraksi saat provider lmstudio.
LM_STUDIO_BASE_URL=http://localhost:1234/v1
LM_STUDIO_MODEL=qwen2.5-3b-instruct

# === Prefilter batch ===
# Estimasi token maksimum per panggilan prefilter ke LM Studio.
# Sisa context window dipakai system prompt, few-shot, skema, dan output.
PREFILTER_BATCH_TOKENS=6000

# === Provider default tahap ekstraksi: lmstudio (lokal, gratis) atau gemini ===
# Gemini hanya untuk ekstraksi; prefilter & verifikasi tetap LM Studio.
# Dapat dioverride per dokumen lewat body POST /api/documents/:id/extract.
EXTRACT_PROVIDER=lmstudio

# === Threshold verifikasi ===
CONF_THRESHOLD=0.6
EMBED_VERIFY_THRESHOLD=0.5
USE_EMBEDDING_FALLBACK=true
EMBEDDING_MODEL=Xenova/multilingual-e5-small
