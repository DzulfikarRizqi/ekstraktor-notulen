  "item": [
    {
      "name": "1. Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        },
        "description": "Smoke test paling awal. Backend hidup? Gemini API key terbaca (config.py validate_required) dan LM Studio sudah jalan? Kalau 500 dengan pesan 'GEMINI_API_KEY wajib diisi', perbaiki backend/.env lalu restart uvicorn. Untuk memastikan LM Studio, cek juga POST #5 tidak berakhir status=failed."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Backend hidup\", () => pm.expect(pm.response.json().status).to.eql(\"ok\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Buat Dokumen",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/documents",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "documents"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Notulen Rapat — Sistem Antrean Klinik\",\n  \"content\": \"Notulen Rapat Koordinasi — Sistem Antrean Klinik, dibuka pukul 09.00 oleh ketua komite. Hadirin tim IT, Petugas Pendaftaran, dan Supervisor.\\n\\nPasien ingin bisa mendaftar dan mengambil nomor antrean langsung dari smartphone tanpa harus datang lebih awal ke klinik. Supaya waktu tunggu di ruang tunggu bisa jauh lebih singkat.\\n\\nPetugas pendaftaran harus bisa memanggil pasien berikutnya secara otomatis lewat monitor dan pengeras suara. Jadi supaya salah panggil nomor antrean bisa diminimalkan.\\n\\nSupervisor perlu melihat laporan rekap jumlah pasien yang dilayani per hari beserta rata-rata waktu tunggunya. Supaya jumlah petugas pendaftaran bisa diatur sesuai kebutuhan.\\n\\nPasien juga meminta supaya bisa membatalkan nomor antrean secara daring kalau ternyata tidak jadi datang.\\n\\nIntegrasi dengan sistem BPJS ditunda untuk dibahas pada rapat berikutnya karena jawabannya belum final. Diskusi ditutup pukul 11.00.\"\n}"
        },
        "description": "Membuat dokumen notulen (FR-01). Konten 1–50.000 karakter. Respon 201 menyimpan `docId` ke variabel koleksi."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const res = pm.response.json();",
              "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
              "pm.test(\"Ada id dokumen\", () => pm.expect(res.data.id).to.not.be.empty);",
              "pm.collectionVariables.set(\"docId\", res.data.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "3. Daftar Dokumen",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/documents",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "documents"
          ]
        },
        "description": "Menampilkan daftar dokumen urut terbaru ke terlama (FR-02)."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "const res = pm.response.json();",
              "pm.test(\"Berupa array data\", () => pm.expect(Array.isArray(res.data)).to.be.true);"
            ]
          }
        }
      ]
    },
    {
      "name": "4. Detail Dokumen (sebelum ekstraksi)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/documents/{{docId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "documents",
            "{{docId}}"
          ]
        },
        "description": "Detail dokumen (FR-07). Jalankan segera setelah #2 untuk melihat status `pending` (sentences & stories masih kosong)."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const res = pm.response.json().data;",
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Ada field status & truncated\", () => {",
              "  pm.expect(res.status).to.be.a(\"string\");",
              "  pm.expect(res.truncated).to.be.a(\"boolean\");",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "5. Mulai Ekstraksi",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/documents/{{docId}}/extract",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "documents",
            "{{docId}}",
            "extract"
          ]
        },
        "description": "Menjalankan job pipeline async: segmentasi → prefilter (qwen) → ekstraksi (Gemini) → verifikasi (qwen + embedding). Respon 202 `processing`. Mengeset ulang saat sedang proses → 409."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 202 processing\", () => {",
              "  pm.response.to.have.status(202);",
              "  pm.expect(pm.response.json().data.status).to.eql(\"processing\");",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "6. Polling Hasil Ekstraksi",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/documents/{{docId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "documents",
            "{{docId}}"
          ]
        },
        "description": "Ulangi (tombol Send) tiap ~2–5 detik sampai `status: completed` atau `failed`. Saat `completed`, menyimpan `storyId` (story pertama) dan `sentenceId` (kalimat terakhir, untuk demo FR-11) ke variabel koleksi. Periksa: sentences[].index 0-based, userStories (maks 30), citations[].verificationStatus / llmVerdict / confidenceScore / embeddingSimilarity."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const res = pm.response.json().data;",
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "if (res.status === \"completed\") {",
              "  pm.test(\"Berdasarkan spek: minimal 1 user story\", () => pm.expect(res.userStories.length).to.be.gte(1));",
              "  pm.test(\"Berdasarkan spek: index kalimat 0-based\", () => res.sentences.forEach((s) => pm.expect(s.index).to.be.at.least(0)));",
              "  pm.test(\"Citation pakai skema verifikasi\", () => {",
              "    for (const u of res.userStories) for (const c of u.citations) {",
              "      pm.expect(c.verificationStatus).to.be.oneOf([\"valid\", \"needs_review\"]);",
              "      pm.expect(c.llmVerdict).to.be.a(\"boolean\");",
              "    }",
              "  });",
              "  pm.collectionVariables.set(\"storyId\", res.userStories[0].id);",
              "  if (res.sentences.length > 0) {",
              "    pm.collectionVariables.set(\"sentenceId\", res.sentences[res.sentences.length - 1].id);",
              "  }",
              "} else if (res.status === \"failed\") {",
              "  pm.test(\"Ada pesan error\", () => pm.expect(res.error).to.be.a(\"string\"));",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "7. Ekspor Hasil",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/documents/{{docId}}/export?format=md&filter=all",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "documents",
            "{{docId}}",
            "export"
          ],
          "query": [
            {
              "key": "format",
              "value": "md"
            },
            {
              "key": "filter",
              "value": "all"
            }
          ]
        },
        "description": "Ekspor Markdown (prob juga `format=csv`). Filter: `approved` (default), `all`, `pending`, `needs_review` (FR-13). Respon berupa file lampiran."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Header unduhan ada\", () => pm.expect(pm.response.headers.get(\"Content-Disposition\")).to.include(\"attachment\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "8. Ekspor CSV",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/documents/{{docId}}/export?format=csv&filter=all",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "documents",
            "{{docId}}",
            "export"
          ],
          "query": [
            {
              "key": "format",
              "value": "csv"
            },
            {
              "key": "filter",
              "value": "all"
            }
          ]
        },
        "description": "Ekspor CSV (FR-13). Kolom: story_code, actor, action, benefit, status, source_indices. `source_indices` memakai indeks kalimat 0-based yang dipisah titik koma."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Header unduhan ada\", () => pm.expect(pm.response.headers.get(\"Content-Disposition\")).to.include(\"attachment\"));",
              "pm.test(\"Ada header kolom\", () => pm.expect(pm.response.text()).to.include(\"story_code,actor,action,benefit,status,source_indices\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "9. Setujui / Tolak Story",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/stories/{{storyId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "stories",
            "{{storyId}}"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"approved\"\n}"
        },
        "description": "Aksi review: status `pending` → `approved`/`rejected`/`pending` (FR-09). Bisa juga mengubah actor/action/benefit (FR-10)."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const res = pm.response.json().data;",
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Status berubah\", () => pm.expect(res.status).to.eql(\"approved\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "10. Hapus Story",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/stories/{{storyId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "stories",
            "{{storyId}}"
          ]
        },
        "description": "Menghapus satu user story beserta citation-nya (cascade delete, FR-09). Jalankan setelah #9 bila ingin mencoba filter `approved` pada #7 — tanpa ini semua story berstatus `pending` sehingga export `approved` kosong."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"OK\", () => pm.expect(pm.response.json().data.ok).to.be.true);"
            ]
          }
        }
      ]
    },
    {
      "name": "11. Tambah Sumber Manual",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/stories/{{storyId}}/sources",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "stories",
            "{{storyId}}",
            "sources"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"sentenceId\": \"{{sentenceId}}\"\n}"
        },
        "description": "Analis menautkan kalimat sumber secara manual (FR-11). Link baru berstatus `needs_review` tanpa panggilan LLM. Jika 409 (kalimat sudah tertaut), pakai id kalimat lain dari respon #5, atau lanjut ke request #9 untuk menghapusnya."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Sukses (201) atau sudah ada (409)\", () => pm.expect([201, 409]).to.include(pm.response.code));"
            ]
          }
        }
      ]
    },
    {
      "name": "12. Hapus Sumber Manual",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/stories/{{storyId}}/sources?sentenceId={{sentenceId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "stories",
            "{{storyId}}",
            "sources"
          ],
          "query": [
            {
              "key": "sentenceId",
              "value": "{{sentenceId}}"
            }
          ]
        },
        "description": "Menghapus tautan kalimat dari story (FR-11)."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"OK\", () => pm.expect(pm.response.json().data.ok).to.be.true);"
            ]
          }
        }
      ]
    },
    {
      "name": "13a. Combined — One-Shot Extract",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": {
          "raw": "{{baseUrl}}/api/documents/extract?wait=90",
          "host": ["{{baseUrl}}"],
          "path": ["api", "documents", "extract"],
          "query": [{ "key": "wait", "value": "90" }]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"content\": \"Pasien ingin daftar online. Petugas panggil nomor otomatis. Supervisor lihat laporan harian.\"\n}"
        },
        "description": "Satu request: buat dokumen + 4 tahap + hasil. Pakai ?wait=90 untuk menunggu hasil. Respons 200 = DocumentDto lengkap. Tanpa ?wait = 202 async."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const s = pm.response.code;",
              "pm.test(\"Status 200/202\", () => pm.expect(s).to.be.oneOf([200, 202]));",
              "if (s === 200) {",
              "  pm.test(\"Ada userStories\", () => pm.expect(pm.response.json().data.userStories).to.be.an('array').that.is.not.empty);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "13b. Stages — Segment",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": {
          "raw": "{{baseUrl}}/api/documents/{{docId}}/stages/segment",
          "host": ["{{baseUrl}}"],
          "path": ["api", "documents", "{{docId}}", "stages", "segment"]
        },
        "description": "Tahap 1/4: segmentasi teks menjadi kalimat (regex, tanpa LLM). Lihat juga console uvicorn untuk log [segment]."
      }
    },
    {
      "name": "13c. Stages — Prefilter",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": {
          "raw": "{{baseUrl}}/api/documents/{{docId}}/stages/prefilter",
          "host": ["{{baseUrl}}"],
          "path": ["api", "documents", "{{docId}}", "stages", "prefilter"]
        },
        "description": "Tahap 2/4: LM Studio menyaring kalimat relevan. Respon: relevantIndices, droppedIndices, sentences[].isRelevant. Console: log [prefilter] dengan jumlah lolos/dibuang."
      }
    },
    {
      "name": "13d. Stages — Extract",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": {
          "raw": "{{baseUrl}}/api/documents/{{docId}}/stages/extract",
          "host": ["{{baseUrl}}"],
          "path": ["api", "documents", "{{docId}}", "stages", "extract"]
        },
        "description": "Tahap 3/4: Gemini mengekstrak User Story. Hasil: userStories[] dengan actor/action/benefit/sourceIndices. Citations BELUM diverifikasi (llmReason null). Lanjutkan ke verify."
      }
    },
    {
      "name": "13e. Stages — Verify",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": {
          "raw": "{{baseUrl}}/api/documents/{{docId}}/stages/verify",
          "host": ["{{baseUrl}}"],
          "path": ["api", "documents", "{{docId}}", "stages", "verify"]
        },
        "description": "Tahap 4/4: LM Studio memverifikasi setiap citation. Hasil: verifiedCount, skippedCount, citations[] dengan verificationStatus, confidenceScore, llmReason. Idempotent — bisa dijalankan ulang."
      }
    },
    {
      "name": "14. Ekstraksi dengan Wait",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": {
          "raw": "{{baseUrl}}/api/documents/{{docId}}/extract?wait=120",
          "host": ["{{baseUrl}}"],
          "path": ["api", "documents", "{{docId}}", "extract"],
          "query": [{ "key": "wait", "value": "120" }]
        },
        "description": "Tambahan di endpoint /extract yang sudah ada: tambahkan ?wait=N (N maks 300) untuk menunggu hasil. 200 = DocumentDto, 202 = async timeout."
      }
    }
  ],
